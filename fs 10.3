# === BACKEND ===
# backend/server.js
const express = require('express');
const mongoose = require('mongoose');
const cors = require('cors');
const jwt = require('jsonwebtoken');
const bcrypt = require('bcryptjs');
require('dotenv').config();
const app = express();
app.use(express.json());
app.use(cors());
mongoose.connect(process.env.MONGO_URI);
const User = mongoose.model('User', new mongoose.Schema({ username: String, email: String, password: String }));
const Post = mongoose.model('Post', new mongoose.Schema({
  text: String, image: String, likes: [String],
  author: { type: mongoose.Schema.Types.ObjectId, ref: 'User' },
  comments: [{ user: String, text: String }]
}));
app.post('/register', async (req, res) => {
  const hashed = await bcrypt.hash(req.body.password, 10);
  const user = await User.create({ ...req.body, password: hashed });
  res.json(user);
});
app.post('/login', async (req, res) => {
  const user = await User.findOne({ email: req.body.email });
  if (!user || !(await bcrypt.compare(req.body.password, user.password))) return res.status(400).json({ msg: 'Invalid' });
  const token = jwt.sign({ id: user._id }, process.env.JWT_SECRET);
  res.json({ token, user });
});
app.get('/posts', async (req, res) => res.json(await Post.find().populate('author')));
app.post('/posts', async (req, res) => {
  const user = jwt.verify(req.headers.authorization, process.env.JWT_SECRET);
  const post = await Post.create({ ...req.body, author: user.id });
  res.json(post);
});
app.put('/posts/:id/like', async (req, res) => {
  const user = jwt.verify(req.headers.authorization, process.env.JWT_SECRET);
  const post = await Post.findById(req.params.id);
  post.likes.includes(user.id)
    ? post.likes = post.likes.filter(u => u !== user.id)
    : post.likes.push(user.id);
  await post.save();
  res.json(post);
});
app.post('/posts/:id/comment', async (req, res) => {
  const user = jwt.verify(req.headers.authorization, process.env.JWT_SECRET);
  const post = await Post.findById(req.params.id);
  post.comments.push({ user: user.id, text: req.body.text });
  await post.save();
  res.json(post);
});
app.listen(5000, () => console.log("Server running"));


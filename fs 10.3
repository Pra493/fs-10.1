# === FRONTEND ===
# frontend/src/index.js
import React from 'react';
import ReactDOM from 'react-dom/client';
import App from './App';
import './index.css';
ReactDOM.createRoot(document.getElementById('root')).render(<App />);

# frontend/src/App.js
import React, { useState, useEffect } from 'react';
import axios from 'axios';
function App() {
  const [user, setUser] = useState(null);
  const [email, setEmail] = useState(''); const [password, setPassword] = useState('');
  const [posts, setPosts] = useState([]); const [text, setText] = useState('');
  const fetchPosts = async () => setPosts((await axios.get('http://localhost:5000/posts')).data);
  useEffect(() => { fetchPosts(); }, []);
  const login = async () => {
    const res = await axios.post('http://localhost:5000/login', { email, password });
    setUser(res.data);
  };
  const createPost = async () => {
    await axios.post('http://localhost:5000/posts', { text }, { headers: { Authorization: user.token } });
    fetchPosts();
  };
  const likePost = async id => {
    await axios.put(`http://localhost:5000/posts/${id}/like`, {}, { headers: { Authorization: user.token } });
    fetchPosts();
  };
  return (
    <div style={{ padding: 20 }}>
      {!user ? (
        <div>
          <h2>Login</h2>
          <input placeholder="Email" onChange={e => setEmail(e.target.value)} />
          <input type="password" placeholder="Password" onChange={e => setPassword(e.target.value)} />
          <button onClick={login}>Login</button>
        </div>
      ) : (
        <div>
          <h2>Create Post</h2>
          <input placeholder="What's on your mind?" onChange={e => setText(e.target.value)} />
          <button onClick={createPost}>Post</button>
          <h2>Feed</h2>
          {posts.map(p => (
            <div key={p._id} style={{ border: '1px solid #ccc', margin: 10, padding: 10 }}>
              <p>{p.text}</p>
              <button onClick={() => likePost(p._id)}>❤️ {p.likes.length}</button>
              <small>By {p.author?.username || 'User'}</small>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}
export default App;

